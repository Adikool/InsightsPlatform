# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Warehouse connection ───────────────────────────────────────────────────────
# Set this to your database. Then install the matching driver (see below).
#
# ┌─ DuckDB (no extra install needed, great for local files / S3 / CSV) ───────
# DP_WAREHOUSE_URI=duckdb:///path/to/your.duckdb
# Install: pip install -e ".[api]"
#
# ┌─ PostgreSQL ────────────────────────────────────────────────────────────────
# DP_WAREHOUSE_URI=postgresql+psycopg://user:password@host:5432/dbname
# Install: pip install -e ".[api,postgres]"
#
# ┌─ SQL Server ────────────────────────────────────────────────────────────────
# DP_WAREHOUSE_URI=mssql+pyodbc://user:password@host/dbname?driver=ODBC+Driver+18+for+SQL+Server
# Install: pip install -e ".[api,mssql]"   +  install the ODBC driver for your OS
#   Windows: https://learn.microsoft.com/sql/connect/odbc/download-odbc-driver-for-sql-server
#   Mac:     brew install msodbcsql18
#   Linux:   see Microsoft docs above
#
# ┌─ SQLite (built-in, good for testing) ──────────────────────────────────────
# DP_WAREHOUSE_URI=sqlite:///path/to/database.db
# Install: pip install -e ".[api]"
#
# Leave blank to use a local DuckDB file at ~/.insight-platform/warehouse.duckdb
DP_WAREHOUSE_URI=

# ── Superset integration (optional — skip if not using dashboards) ─────────────
# How Superset reaches the warehouse from inside Docker.
# Use the Docker-internal hostname, not localhost.
# Example: DP_SUPERSET_WAREHOUSE_URI=postgresql+psycopg2://user:password@db-host:5432/dbname
DP_SUPERSET_WAREHOUSE_URI=

# SUPERSET_URL=http://localhost:8088
# SUPERSET_USERNAME=admin
# SUPERSET_PASSWORD=admin

# ── Advanced (all optional) ───────────────────────────────────────────────────
# DP_MODEL=claude-opus-5
# DP_EFFORT=medium
# DP_MAX_TOKENS=8000
# DP_MAX_ROWS=50000
# DP_DEFAULT_LIMIT=1000
